      "pii": {"file": "fixtures/tamper_matrix/chain/response_pii.json", "hash": "blake3:ea22fe15dd408edf32031a7711e66c80c5f45da0cc5b3c5c6c67276592c53a31"},
      "html": {"file": "fixtures/tamper_matrix/chain/response_html.json", "hash": "blake3:a7816f5e9356aee44c60dd27dd49a2fdf431f226b5491bba31aa9ea6a6f3b630"},
      "aws_key": {"file": "fixtures/tamper_matrix/chain/response_aws_key.json", "hash": "blake3:709fe9614281ace67b5269e887fb9d8136c8607468c11b98738369fa03c52ffb"}
    },
    "artifacts": {
      "declared": {"file": "fixtures/tamper_matrix/chain/tool_declared.txt", "hash": "blake3:de065565e3e7dc131ce11b2ece4edae3ef1647057601682b55aa417984c9e82f", "declared_in_policy": true},
      "undeclared": {"file": "fixtures/tamper_matrix/chain/tool_undeclared.txt", "hash": "blake3:441c72970f9e9b5ec54de50047a59aab90ab1ab70f5d7c293374c898d24b15eb", "declared_in_policy": false},
      "declared_pii": {"file": "fixtures/tamper_matrix/chain/tool_pii.txt", "hash": "blake3:20cfe51cf3a6598c4576b6420340c7d1258bc4ecd0b25e723012c3f88e41e176", "declared_in_policy": true}
