{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/airlock_policy.schema.json",
  "title": "airlock policy schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "extends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "airlock.v0"
    },
    "allowed_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key_path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "boundary_class": {
            "type": "string",
            "enum": [
              "TELEMETRY",
              "DERIVED_TEXT"
            ]
          }
        },
        "required": [
          "key_path"
        ]
      }
    },
    "forbidden_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "artifact_class": {
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ]
      }
    },
    "derived_text_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "BOUNDARY_FAILED",
          "RAW_DOCUMENT_ABSENT",
          "STRICT_TELEMETRY_ONLY"
        ]
      }
    },
    "detectors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["secrets", "pii", "tabular", "blobs", "paths"]
      },
      "description": "Opt-in deterministic detector packs. Omitted or empty means no generic detectors are enabled."
    },
    "detectors_warn_only": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["secrets", "pii", "tabular", "blobs", "paths"]
      },
      "description": "Enabled detector packs that record DETECTED_SENSITIVE findings without lowering the claim. Each entry must also appear in detectors."
    },
    "protected_bloom_min_hits": {
      "type": "integer",
      "minimum": 1,
      "description": "Minimum matching rolling shingles required to block a protected-corpus match; defaults to 8 when --protected-bloom is enabled."
    },
    "tabular_min_rows": {
      "type": "integer",
      "minimum": 2,
      "default": 5,
      "description": "Minimum repeated delimited rows required by the tabular detector pack."
    },
    "allow_multimodal": {
      "type": "boolean",
      "default": false,
      "description": "Allow image and document attachments through policy-proxy mode. Omitted values deny attachments."
    },
    "declared_tool_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_hash": {
            "type": "string",
            "pattern": "^blake3:[0-9a-f]{64}$"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "artifact_hash"
        ]
      },
      "description": "Local artifacts the operator vouches for as tool results. A tool result in a chained prompt keeps the strict claim reachable only if the blake3 hash of its exact content is listed here; otherwise it caps the claim at RAW_DOCUMENT_ABSENT. Older airlock versions refuse a policy that uses this key."
    }
  },
  "if": {
    "required": ["extends"]
  },
  "else": {
    "required": [
      "policy_id",
      "version",
      "allowed_keys",
      "forbidden_keys",
      "forbidden_patterns",
      "derived_text_paths",
      "claim_levels"
    ]
  }
}
