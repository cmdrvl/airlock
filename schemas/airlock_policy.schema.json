{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/airlock_policy.schema.json",
  "title": "airlock policy schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "extends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "airlock.v0"
    },
    "allowed_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key_path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "boundary_class": {
            "type": "string",
            "enum": [
              "TELEMETRY",
              "DERIVED_TEXT"
            ]
          }
        },
        "required": [
          "key_path"
        ]
      }
    },
    "forbidden_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "artifact_class": {
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ]
      }
    },
    "derived_text_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "BOUNDARY_FAILED",
          "RAW_DOCUMENT_ABSENT",
          "STRICT_TELEMETRY_ONLY"
        ]
      }
    },
    "protected_bloom_min_hits": {
      "type": "integer",
      "minimum": 1,
      "description": "Minimum matching rolling shingles required to block a protected-corpus match; defaults to 8 when --protected-bloom is enabled."
    },
    "allow_multimodal": {
      "type": "boolean",
      "default": false,
      "description": "Allow image and document attachments through policy-proxy mode. Omitted values deny attachments."
    }
  },
  "if": {
    "required": ["extends"]
  },
  "else": {
    "required": [
      "policy_id",
      "version",
      "allowed_keys",
      "forbidden_keys",
      "forbidden_patterns",
      "derived_text_paths",
      "claim_levels"
    ]
  }
}
