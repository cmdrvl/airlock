{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/airlock.v0.schema.json",
  "title": "airlock manifest schema",
  "description": "Schema for the primary airlock proof artifact emitted by verify.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "enum": [
        "airlock.v0.2",
        "airlock.v0.3",
        "airlock.v0.4"
      ]
    },
    "binding_status": {
      "type": "string",
      "enum": [
        "BOUND",
        "UNBOUND"
      ]
    },
    "boundary_mode": {
      "$ref": "#/$defs/boundaryMode"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_hash": {
      "$ref": "#/$defs/blake3Hash"
    },
    "claim_levels_evaluated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimLevel"
      }
    },
    "achieved_claim": {
      "$ref": "#/$defs/claimLevel"
    },
    "upstream_artifact_inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/upstreamArtifact"
      }
    },
    "system_prompt_hash": {
      "$ref": "#/$defs/blake3Hash"
    },
    "prompt_payload_hash": {
      "$ref": "#/$defs/blake3Hash"
    },
    "prompt_provenance_hash": {
      "$ref": "#/$defs/blake3Hash"
    },
    "prompt_provenance_ref": {
      "type": "string",
      "minLength": 1
    },
    "request_payload_hash": {
      "$ref": "#/$defs/blake3Hash"
    },
    "replay_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "raw_document_present": {
      "type": "boolean"
    },
    "filing_derived_text_present": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blockedReason"
      }
    },
    "provenance_summary": {
      "$ref": "#/$defs/provenanceSummary"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "bytes_crossed": {
      "description": "airlock.v0.3 and later. Length in bytes of the RFC 8785 canonical request JSON covered by request_payload_hash.",
      "type": "integer",
      "minimum": 0
    },
    "attestation": {
      "description": "airlock.v0.3 and later. verify writes self_attested. send writes transmitted when it sent the request and self_attested when it did not; see transmission. gated is reserved for gate receipts.",
      "type": "string",
      "enum": [
        "self_attested",
        "transmitted",
        "gated"
      ]
    },
    "not_crossed": {
      "description": "airlock.v0.3 and later, only when verify was given the assemble run's not-crossed inventory. Every input field that did not cross the boundary; values are never stored. Absent means no inventory was supplied; an empty array means nothing was left out.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/notCrossedEntry"
      }
    },
    "transmission": {
      "$ref": "#/$defs/transmission"
    },
    "chain": {
      "description": "airlock.v0.4 only, and required there. The turn this manifest follows, copied from the prompt provenance assemble wrote. A manifest with no chain member is turn 0 and is airlock.v0.3. prior_manifest_hash is the hash of the prior turn's manifest as the gate computes it (the canonical JSON of the parsed manifest, signature included); turn_index is 1 after a manifest with no chain member and one more than the prior manifest's index after that.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prior_manifest_hash": {
          "$ref": "#/$defs/blake3Hash"
        },
        "turn_index": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "prior_manifest_hash",
        "turn_index"
      ]
    },
    "signature": {
      "description": "airlock.v0.3 and later, absent when verify ran with --no-sign. Ed25519 signature over the canonical JSON of this manifest with the signature member removed. The public key is not embedded: public_key_fingerprint names the signer and `airlock verify-manifest` is given the key.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "public_key_fingerprint": {
          "$ref": "#/$defs/blake3Hash"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "algorithm",
        "public_key_fingerprint",
        "value"
      ]
    }
  },
  "allOf": [
    {
      "description": "A v0.4 manifest carries a chain member; no other version may.",
      "if": {
        "properties": {
          "manifest_version": {
            "const": "airlock.v0.4"
          }
        }
      },
      "then": {
        "required": [
          "chain"
        ]
      },
      "else": {
        "not": {
          "required": [
            "chain"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "manifest_version": {
            "enum": [
              "airlock.v0.3",
              "airlock.v0.4"
            ]
          }
        }
      },
      "then": {
        "required": [
          "bytes_crossed",
          "attestation"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "bytes_crossed"
              ]
            },
            {
              "required": [
                "attestation"
              ]
            },
            {
              "required": [
                "not_crossed"
              ]
            },
            {
              "required": [
                "signature"
              ]
            },
            {
              "required": [
                "transmission"
              ]
            }
          ]
        }
      }
    },
    {
      "description": "A manifest that says it was transmitted carries the transmission, and it says sent.",
      "if": {
        "required": [
          "attestation"
        ],
        "properties": {
          "attestation": {
            "const": "transmitted"
          }
        }
      },
      "then": {
        "required": [
          "transmission"
        ],
        "properties": {
          "transmission": {
            "properties": {
              "sent": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "description": "A transmission that sent the request goes with attestation transmitted.",
      "if": {
        "required": [
          "transmission"
        ],
        "properties": {
          "transmission": {
            "required": [
              "sent"
            ],
            "properties": {
              "sent": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "attestation"
        ],
        "properties": {
          "attestation": {
            "const": "transmitted"
          }
        }
      }
    },
    {
      "description": "A transmission that did not send the request goes with attestation self_attested: nothing was transmitted.",
      "if": {
        "required": [
          "transmission"
        ],
        "properties": {
          "transmission": {
            "required": [
              "sent"
            ],
            "properties": {
              "sent": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "attestation"
        ],
        "properties": {
          "attestation": {
            "const": "self_attested"
          }
        }
      }
    }
  ],
  "required": [
    "manifest_version",
    "binding_status",
    "boundary_mode",
    "policy_id",
    "policy_hash",
    "claim_levels_evaluated",
    "achieved_claim",
    "upstream_artifact_inventory",
    "system_prompt_hash",
    "prompt_payload_hash",
    "prompt_provenance_hash",
    "prompt_provenance_ref",
    "request_payload_hash",
    "replay_ref",
    "model_id",
    "adapter",
    "raw_document_present",
    "filing_derived_text_present",
    "findings",
    "blocked_reasons",
    "provenance_summary",
    "timestamp"
  ],
  "$defs": {
    "blake3Hash": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "transmission": {
      "description": "airlock.v0.3 and later, only on a manifest airlock send wrote. What send did with the request; only the body is attested, not headers. sent is false only when the body was certainly never written; a failure after connecting is sent true with no response and an error.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sent": {
          "type": "boolean"
        },
        "endpoint_host": {
          "description": "Host, and port when not the scheme's default. Never the path, query or credentials.",
          "type": "string",
          "minLength": 1
        },
        "request_bytes": {
          "description": "Length of the request body; equals bytes_crossed.",
          "type": "integer",
          "minimum": 0
        },
        "request_hash": {
          "description": "blake3 of the bytes handed to the connection; equals request_payload_hash.",
          "$ref": "#/$defs/blake3Hash"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "response_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "response_hash": {
          "description": "blake3 of the response body as received.",
          "$ref": "#/$defs/blake3Hash"
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string",
          "enum": [
            "CLAIM_BELOW_REQUIRED",
            "CONNECT_FAILED",
            "RESPONSE_TIMEOUT",
            "RESPONSE_TOO_LARGE",
            "TRANSPORT_ERROR"
          ]
        }
      },
      "required": [
        "sent",
        "endpoint_host",
        "request_bytes",
        "request_hash"
      ],
      "dependentRequired": {
        "response_status": [
          "response_hash",
          "response_bytes"
        ],
        "response_hash": [
          "response_status",
          "response_bytes"
        ],
        "response_bytes": [
          "response_status",
          "response_hash"
        ]
      },
      "allOf": [
        {
          "description": "A request that was sent records when and how long.",
          "if": {
            "properties": {
              "sent": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "sent_at",
              "latency_ms"
            ]
          },
          "else": {
            "description": "A request that was not sent has no time, no response, and says why.",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "enum": [
                  "CLAIM_BELOW_REQUIRED",
                  "CONNECT_FAILED"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sent_at"
                  ]
                },
                {
                  "required": [
                    "latency_ms"
                  ]
                },
                {
                  "required": [
                    "response_status"
                  ]
                }
              ]
            }
          }
        },
        {
          "description": "A sent request either got a response or says why not, never both and never neither.",
          "if": {
            "properties": {
              "sent": {
                "const": true
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "response_status"
                ],
                "not": {
                  "required": [
                    "error"
                  ]
                }
              },
              {
                "required": [
                  "error"
                ],
                "not": {
                  "required": [
                    "response_status"
                  ]
                },
                "properties": {
                  "error": {
                    "enum": [
                      "RESPONSE_TIMEOUT",
                      "TRANSPORT_ERROR"
                    ]
                  }
                }
              },
              {
                "required": [
                  "error",
                  "response_status"
                ],
                "properties": {
                  "error": {
                    "const": "RESPONSE_TOO_LARGE"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "boundaryMode": {
      "type": "string",
      "enum": [
        "ANNOTATED",
        "TELEMETRY_ONLY"
      ]
    },
    "claimLevel": {
      "type": "string",
      "enum": [
        "BOUNDARY_FAILED",
        "RAW_DOCUMENT_ABSENT",
        "STRICT_TELEMETRY_ONLY"
      ]
    },
    "notCrossedEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "source_artifact_hash": {
          "$ref": "#/$defs/blake3Hash"
        },
        "value_hash": {
          "$ref": "#/$defs/blake3Hash"
        },
        "reason": {
          "type": "string",
          "enum": [
            "NOT_ALLOWED",
            "FORBIDDEN_KEY",
            "DERIVED_TEXT_EXCLUDED",
            "SHADOWED_BY_EARLIER_INPUT"
          ]
        }
      },
      "required": [
        "path",
        "source_artifact_hash",
        "value_hash",
        "reason"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key_path": {
          "type": "string",
          "minLength": 1
        },
        "sample_value": {
          "type": "string"
        },
        "artifact_class": {
          "type": "string",
          "minLength": 1
        },
        "matched_rule": {
          "type": "string",
          "minLength": 1
        },
        "span_hash": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "description": "Hash of the matched detector span; sensitive content is never included."
        }
      },
      "required": [
        "key_path",
        "artifact_class",
        "matched_rule"
      ]
    },
    "blockedReason": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_attempted": {
          "$ref": "#/$defs/claimLevel"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "offending_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "claim_attempted",
        "reason",
        "offending_paths"
      ]
    },
    "upstreamArtifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "$ref": "#/$defs/blake3Hash"
        },
        "artifact_class": {
          "type": "string",
          "minLength": 1
        },
        "extends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "path",
        "content_hash",
        "artifact_class"
      ]
    },
    "provenanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_fragments": {
          "type": "integer",
          "minimum": 0
        },
        "by_boundary_class": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "total_fragments",
        "by_boundary_class"
      ]
    }
  }
}
